OS_ID=kylin
OS_VERSION_ID=V10
OS_ARCH=aarch64
OS_PRETTY="Kylin Linux Advanced Server V10"

# CRITICAL: SP version MUST be determined from:
#   - /etc/kylin-release
#   - kylin-release RPM version
#   - VERSION field in /etc/os-release
